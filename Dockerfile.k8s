# Stage 1: Build frontend
FROM node:16-alpine as fe-builder

WORKDIR /app/web

# Install additional packages for better build stability
RUN apk add --no-cache python3 make g++

# Copy package files first for better caching
COPY web/package.json web/yarn.lock ./

# Install dependencies with SSL verification disabled and increased timeout
RUN yarn config set strict-ssl false && \
    yarn config set network-timeout 300000 && \
    yarn install --frozen-lockfile --network-concurrency 1

# Copy frontend source code
COPY web/ ./

# Build frontend with optimized Node.js settings and increased memory
    RUN export NODE_OPTIONS="--max-old-space-size=8192" && \
        export CI=false && \
        export NODE_ENV=production && \
        export GENERATE_SOURCEMAP=false && \
        cp -R ./node_modules/monaco-editor ./public/ && \
        node --max_old_space_size=8192 ./node_modules/.bin/umi build

# Stage 2: Build backend API
FROM golang:1.19-alpine as api-builder

WORKDIR /app/api

# Install build dependencies
RUN apk add --no-cache git make ca-certificates

# Configure Go proxy settings for better network reliability
ENV GOPROXY=https://goproxy.cn,https://goproxy.io,https://mirrors.aliyun.com/goproxy/,https://proxy.golang.org,direct
ENV GOSUMDB=off
ENV GOPRIVATE=""
ENV GONOPROXY=""
ENV GONOSUMDB=""
ENV GO111MODULE=on

# Copy go mod files first for better caching
COPY api/go.mod api/go.sum ./

# Download dependencies with enhanced retry mechanism and multiple fallback options
RUN set -e; \
    echo "Starting Go module download with enhanced retry mechanism..."; \
    \
    # First attempt with Chinese mirrors
    echo "Attempt 1: Using Chinese mirrors (goproxy.cn)"; \
    if GOPROXY=https://goproxy.cn,direct GOSUMDB=off go mod download; then \
        echo "✅ Go modules downloaded successfully with goproxy.cn"; \
    else \
        echo "❌ goproxy.cn failed, trying goproxy.io..."; \
        sleep 3; \
        \
        # Second attempt with goproxy.io
        if GOPROXY=https://goproxy.io,direct GOSUMDB=off go mod download; then \
            echo "✅ Go modules downloaded successfully with goproxy.io"; \
        else \
            echo "❌ goproxy.io failed, trying Aliyun mirror..."; \
            sleep 3; \
            \
            # Third attempt with Aliyun mirror
            if GOPROXY=https://mirrors.aliyun.com/goproxy/,direct GOSUMDB=off go mod download; then \
                echo "✅ Go modules downloaded successfully with Aliyun mirror"; \
            else \
                echo "❌ All mirrors failed, trying direct download..."; \
                sleep 3; \
                \
                # Fourth attempt with direct download
                if GOPROXY=direct GOSUMDB=off GOINSECURE="*" go mod download; then \
                    echo "✅ Go modules downloaded successfully with direct download"; \
                else \
                    echo "❌ All download methods failed, trying vendor mode..."; \
                    \
                    # Final fallback: try to use vendor if available or download individual modules
                    if [ -d "vendor" ]; then \
                        echo "📦 Using vendor directory"; \
                        go mod vendor; \
                    else \
                        echo "🔄 Attempting individual module downloads..."; \
                        GOPROXY=https://goproxy.cn,https://goproxy.io,direct GOSUMDB=off GOINSECURE="*" go mod download -x || \
                        (echo "⚠️ Some modules may have failed, continuing with available modules..." && true); \
                    fi; \
                fi; \
            fi; \
        fi; \
    fi; \
    \
    echo "📋 Verifying downloaded modules..."; \
    go mod verify || echo "⚠️ Module verification failed, but continuing..."; \
    echo "✅ Go module download process completed"

# Copy API source code
COPY api/ ./

# Build the API binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w" -o manager-api ./main.go

# Stage 3: Production runtime with nginx
FROM nginx:alpine as runtime

# Install supervisor to manage multiple processes
RUN apk add --no-cache supervisor && \
    mkdir -p /etc/supervisor/conf.d

# Create application directory
WORKDIR /usr/local/apisix-dashboard

# Copy built API binary
COPY --from=api-builder /app/api/manager-api ./

# Copy built frontend files
    COPY --from=fe-builder /app/output/html ./web/dist

# Copy API configuration
COPY api/conf/ ./conf/

# Create logs directory
RUN mkdir -p logs

# Create nginx configuration for serving frontend and proxying API
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 80;
    server_name localhost;
    
    # Enable gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;
    
    # Serve frontend static files
    location / {
        root /usr/local/apisix-dashboard/web/dist;
        try_files $uri $uri/ /index.html;
        index index.html;
        
        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
        
        # Cache HTML files for shorter time
        location ~* \.(html)$ {
            expires 1h;
            add_header Cache-Control "public";
        }
    }
    
    # Proxy login API requests to backend (exact match to avoid path duplication)
        location = /apisix/admin/user/login {
            proxy_pass http://127.0.0.1:9000/apisix/admin/user/login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    # Proxy other API requests to backend
        location /apisix/admin/ {
            proxy_pass http://127.0.0.1:9000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}
EOF

# Create supervisor configuration
RUN cat > /etc/supervisor/conf.d/supervisord.conf << 'EOF'
[supervisord]
nodaemon=true
user=root

[program:nginx]
command=nginx -g "daemon off;"
autorestart=true
stdout_logfile=/var/log/nginx.log
stderr_logfile=/var/log/nginx.log

[program:apisix-dashboard]
command=/bin/sh -c 'if [ -f "/etc/apisix-dashboard/conf.yaml" ]; then exec /usr/local/apisix-dashboard/manager-api -c "/etc/apisix-dashboard/conf.yaml"; else exec /usr/local/apisix-dashboard/manager-api -c "/usr/local/apisix-dashboard/conf/conf.yaml"; fi'
directory=/usr/local/apisix-dashboard
autorestart=true
stdout_logfile=/usr/local/apisix-dashboard/logs/manager-api.log
stderr_logfile=/usr/local/apisix-dashboard/logs/manager-api.log
EOF

# Expose ports
EXPOSE 80 9000

# Start supervisor to manage both nginx and API
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]