# Stage 1: Build frontend
FROM node:16-alpine as fe-builder

WORKDIR /app/web

# Copy package files first for better caching
COPY web/package.json web/yarn.lock ./

# Install dependencies with SSL verification disabled
RUN yarn config set strict-ssl false && \
    yarn install --frozen-lockfile

# Copy frontend source code
COPY web/ ./

# Build frontend with legacy OpenSSL provider for Node.js compatibility
RUN export NODE_OPTIONS="--openssl-legacy-provider" && \
    yarn build

# Stage 2: Build backend API
FROM golang:1.19-alpine as api-builder

WORKDIR /app/api

# Install build dependencies
RUN apk add --no-cache git make ca-certificates

# Configure Go proxy settings for better network reliability
ENV GOPROXY=https://proxy.golang.org,https://goproxy.cn,https://goproxy.io,direct
ENV GOSUMDB=sum.golang.org
ENV GOPRIVATE=""
ENV GONOPROXY=""
ENV GONOSUMDB=""

# Copy go mod files first for better caching
COPY api/go.mod api/go.sum ./

# Download dependencies with retry mechanism
RUN set -e; \
    for i in 1 2 3; do \
        echo "Attempt $i: Downloading Go modules..."; \
        if go mod download; then \
            echo "Go modules downloaded successfully"; \
            break; \
        else \
            echo "Attempt $i failed, retrying in 5 seconds..."; \
            sleep 5; \
        fi; \
        if [ $i -eq 3 ]; then \
            echo "All attempts failed, trying with direct proxy"; \
            GOPROXY=direct go mod download; \
        fi; \
    done

# Copy API source code
COPY api/ ./

# Build the API binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w" -o manager-api ./main.go

# Stage 3: Production runtime with nginx
FROM nginx:alpine as runtime

# Install supervisor to manage multiple processes
RUN apk add --no-cache supervisor

# Create application directory
WORKDIR /usr/local/apisix-dashboard

# Copy built API binary
COPY --from=api-builder /app/api/manager-api ./

# Copy built frontend files
COPY --from=fe-builder /app/web/dist ./web/dist

# Copy API configuration
COPY api/conf/ ./conf/

# Create logs directory
RUN mkdir -p logs

# Create nginx configuration for serving frontend and proxying API
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 80;
    server_name localhost;
    
    # Enable gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;
    
    # Serve frontend static files
    location / {
        root /usr/local/apisix-dashboard/web/dist;
        try_files $uri $uri/ /index.html;
        index index.html;
        
        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
        
        # Cache HTML files for shorter time
        location ~* \.(html)$ {
            expires 1h;
            add_header Cache-Control "public";
        }
    }
    
    # Proxy API requests to backend
    location /apisix/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}
EOF

# Create supervisor configuration
RUN cat > /etc/supervisor/conf.d/supervisord.conf << 'EOF'
[supervisord]
nodaemon=true
user=root

[program:nginx]
command=nginx -g "daemon off;"
autorestart=true
stdout_logfile=/var/log/nginx.log
stderr_logfile=/var/log/nginx.log

[program:apisix-dashboard]
command=/usr/local/apisix-dashboard/manager-api
directory=/usr/local/apisix-dashboard
autorestart=true
stdout_logfile=/usr/local/apisix-dashboard/logs/manager-api.log
stderr_logfile=/usr/local/apisix-dashboard/logs/manager-api.log
EOF

# Expose ports
EXPOSE 80 9000

# Start supervisor to manage both nginx and API
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]